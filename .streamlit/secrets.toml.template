# =====================================================================
# LogiBot — Streamlit secrets template (TIER 3: GitHub CSV commit)
# ---------------------------------------------------------------------
# USAGE:
#   1) For Streamlit CLOUD deployment:
#        - DO NOT rename this file. Instead, copy the [github] block
#          below into share.streamlit.io → your App → Settings →
#          Secrets → paste there, save. That's the canonical location.
#   2) For LOCAL dev testing of the GitHub commit feedback loop:
#        - Duplicate this file in the same folder, rename the copy to
#          secrets.toml (that filename is gitignored). Replace ALL
#          __REPLACE_ME__ placeholders with real values. Then run:
#            streamlit run app.py
#          inside the deploy/ folder and submit a rating in the chat:
#          the row will be appended to YOUR GITHUB REPO's file
#          data/user_feedback.csv via REST API.
# =====================================================================

[github]
# Fine-grained personal access token. Create at:
#   https://github.com/settings/tokens?type=beta
# Required permission on the target repo:
#   Repository permissions → Contents → Read and Write
# Do NOT prefix with Bearer; the script handles that for you.
token = "__REPLACE_ME__ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# GitHub username / org that owns the target repository.
# E.g. owner = 'alice'  for repo github.com/alice/logibot-demo
owner = "__REPLACE_ME__your-github-username-here"

# Repository name only (no slashes, no .git suffix).
# E.g. repo = 'logibot-demo'  for the example URL above.
repo  = "__REPLACE_ME__your-repo-name-here"

# Branch that Streamlit Cloud is running from (almost always main).
# This is the branch that will receive each new feedback commit.
branch = "main"

# Path in the target repository to the CSV that should receive new
# feedback rows. Because we push deploy/ as repo root, the CSV lives
# at data/user_feedback.csv in the repo — so we use that default.
feedback_path = "data/user_feedback.csv"
